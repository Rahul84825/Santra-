```cpp
#include <iostream>
#include <vector>
#include <string>

struct Employee {
    std::string name;
    std::vector<Employee> subordinates;
};

// Returns the total number of people in this employee's subtree,
// including the employee themselves.
int countEmployees(const Employee& boss) {
    // Base case contribution: count the boss themselves.
    int total = 1;

    // Recursive case: delegate to each subordinate.
    for (const auto& sub : boss.subordinates) {
        total += countEmployees(sub);
    }

    return total;
}

int main() {
    // A tiny organisation:
    // CEO
    // ├── VP Engineering
    // │   ├── Manager A (2 devs)
    // │   └── Manager B (1 dev)
    // └── VP Sales (3 salespeople)

    Employee dev1{"Dev 1", {}};
    Employee dev2{"Dev 2", {}};
    Employee managerA{"Manager A", {dev1, dev2}};

    Employee dev3{"Dev 3", {}};
    Employee managerB{"Manager B", {dev3}};

    Employee vpEng{"VP Engineering", {managerA, managerB}};

    Employee s1{"Sales 1", {}};
    Employee s2{"Sales 2", {}};
    Employee s3{"Sales 3", {}};
    Employee vpSales{"VP Sales", {s1, s2, s3}};

    Employee ceo{"CEO", {vpEng, vpSales}};

    std::cout << "Total employees: " << countEmployees(ceo) << std::endl;
    // Output: Total employees: 10
}
```

