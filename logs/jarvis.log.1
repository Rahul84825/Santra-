## 1. Concrete Code Example

```python
def quicksort(arr, low=0, high=None):
    """
    In-place quicksort using the Lomuto partition scheme.
    Sorts arr[low..high] inclusive.
    """
    if high is None:
        high = len(arr) - 1

    # Base case: zero or one element is already sorted
    if low < high:
        # Partition the array and get the final pivot index
        pivot_index = partition(arr, low, high)

        # Recursively sort elements before and after the pivot
        quicksort(arr, low, pivot_index - 1)
        quicksort(arr, pivot_index + 1, high)


def partition(arr, low, high):
    """
    Rearranges arr[low..high] around arr[high] (the pivot).
    Returns the index where the pivot finally resides.
    """
    pivot = arr[high]          # Choose last element as pivot
    i = low - 1                # Boundary of the "≤ pivot" region

    for j in range(low, high):
        if arr[j] <= pivot:
            i += 1
            # Swap current element into the ≤ pivot region
            arr[i], arr[j] = arr[j], arr[i]

    # Place pivot immediately after the ≤ pivot region
    arr[i + 1], arr[high] = arr[high], arr[i + 1]
    return i + 1
```

**Usage:**

```python
data = [10, 80, 30, 90, 40, 50, 70]
quicksort(data)
print(data)   # [10'
